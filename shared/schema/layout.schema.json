{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ESP32-WIFI-Dashboard Layout",
  "oneOf": [
    {"$ref": "#/definitions/v1"},
    {"$ref": "#/definitions/v2"}
  ],
  "definitions": {
    "widget": {
      "type": "object",
      "required": ["id", "type", "x", "y", "w", "h", "bindings"],
      "additionalProperties": false,
      "description": "w/h 必须来自 widgets.json 的 size_options，两个方向通用；alt 只记录另一方向的位置。",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 48},
        "type": {"type": "string"},
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "w": {"type": "integer", "minimum": 1},
        "h": {"type": "integer", "minimum": 1},
        "alt": {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": {"type": "integer", "minimum": 0},
            "y": {"type": "integer", "minimum": 0}
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "options": {"type": "object"}
      }
    },
    "widgets": {
      "type": "array",
      "maxItems": 40,
      "items": {"$ref": "#/definitions/widget"}
    },
    "framework": {
      "type": "string",
      "enum": ["widgets", "classic"],
      "default": "widgets",
      "description": "界面框架：widgets=小组件网格（默认），classic=固定式传统界面主题（横屏 480×320，widgets 留空）。"
    },
    "classic_theme": {
      "type": "string",
      "enum": [
        "instrument", "hud", "mecha", "stealth", "arcade", "drone", "scope",
        "heatsink", "loadout", "armor", "sweep"
      ],
      "default": "instrument",
      "description": "传统框架下的固定界面主题：instrument=磷光示波器，hud=战术 HUD，mecha=机甲反应堆，stealth=潜行终端，arcade=街机计分板，drone=无人机链路，scope=狙击镜，heatsink=散热塔，loadout=装备槽，armor=动力装甲，sweep=战术雷达。"
    },
    "v1": {
      "type": "object",
      "required": ["v", "profile", "widgets"],
      "additionalProperties": false,
      "properties": {
        "v": {"type": "integer", "const": 1},
        "profile": {"type": "string"},
        "theme": {"type": "string"},
        "framework": {"$ref": "#/definitions/framework"},
        "classic_theme": {"$ref": "#/definitions/classic_theme"},
        "widgets": {"$ref": "#/definitions/widgets"}
      }
    },
    "v2": {
      "type": "object",
      "required": ["v", "profile", "pages"],
      "additionalProperties": false,
      "properties": {
        "v": {"type": "integer", "const": 2},
        "profile": {"type": "string"},
        "theme": {"type": "string"},
        "framework": {"$ref": "#/definitions/framework"},
        "classic_theme": {"$ref": "#/definitions/classic_theme"},
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "widgets"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "widgets": {"$ref": "#/definitions/widgets"}
            }
          }
        }
      }
    }
  }
}
